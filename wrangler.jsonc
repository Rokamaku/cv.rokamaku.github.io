{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-rokamaku",
  "compatibility_date": "2026-11-10",
  // Static-assets-only Worker: serves the Next.js static export, including
  // the PDF that `yarn build` generates into public/.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "cv.rokamaku.dev", "custom_domain": true }]
}
