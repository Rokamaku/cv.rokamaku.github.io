{
  "name": "rokamaku_cv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "yarn generate-cv && next build",
    "start": "next start",
    "lint": "eslint .",
    "generate-cv": "node scripts/generate-cv.js",
    "watch-cv": "node scripts/generate-cv.js --watch",
    "deploy": "yarn build && wrangler deploy",
    "format": "prettier --write .",
    "format:scripts": "prettier --write 'scripts/**/*.js'"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "packageManager": "yarn@4.9.1",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.3.0",
    "chokidar": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "html-to-pdf-js": "^0.9.3",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "react-icons": "^5.7.0",
    "sass": "^1.108.1",
    "typescript": "6.0.3",
    "wrangler": "^4.158.0"
  }
}
